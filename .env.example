# ─────────────────────────────────────────────────────────────
# AAHBank environment variables
# Copy this file to `.env.local` for local development.
# On Vercel, add these same keys in Project → Settings → Environment Variables.
#
#   LOCAL:        .env.local          (never commit this file)
#   PRODUCTION:   Vercel dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Where your Supabase project lives. Found in:
#   Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public "anon" key — safe to expose in the browser (RLS protects the data).
#   Supabase dashboard → Project Settings → API → Project API keys → anon / publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Secret "service role" key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
#   Supabase dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Leave all three blank/absent to run in offline Demo Mode (localStorage).
